  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "npm-run-all build:server build:client",
    "build:server": "tsc",
    "build:client": "vite build --mode production",
    "build:client:dev": "vite build --mode development",
