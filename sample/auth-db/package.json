    "migrate:rollback": "pirx migrate rollback",
    "seed": "node scripts/seed.js",
    "setup": "npm run migrate && npm run seed",
    "dev": "node dist/app.js"
  },
  "dependencies": {
    "@kurdel/auth": "0.1.0-beta.4",
    "@kurdel/auth-db": "0.1.0-beta.4",
    "@kurdel/common": "0.1.0-beta.4",
    "@kurdel/core": "0.1.0-beta.4",
    "@kurdel/db": "0.1.0-beta.4",
    "@kurdel/facade": "0.1.0-beta.4",
    "@kurdel/migrations": "0.1.0-beta.4",
    "@kurdel/runtime": "0.1.0-beta.4",
    "@kurdel/runtime-node": "0.1.0-beta.4",
    "@kurdel/template-react": "0.1.0-beta.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@kurdel/pirx": "0.1.0-beta.4",
    "@vitejs/plugin-react": "^5.1.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
