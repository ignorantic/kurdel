{
  "name": "@kurdel/monorepo",
  "private": true,
  "author": "Andrii Sorokin",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild": true,
    "nx": true,
    "sqlite3": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignorantic/kurdel.git"
  },
  "homepage": "https://github.com/ignorantic/kurdel#readme",
  "bugs": {
    "url": "https://github.com/ignorantic/kurdel/issues"
  },
  "workspaces": [
    "packages/*",
    "sample/*"
  ],
  "scripts": {
    "lint": "eslint \"packages/**/*.{ts,tsx}\" \"sample/**/*.{ts,tsx}\" && node --check scripts/check-release.mjs && node --check scripts/check-release-tag.mjs && node --check scripts/publish-packages.mjs",
    "test": "lerna run test --stream",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"{packages,sample}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{packages,sample}/**/*.{ts,tsx}\"",
    "clean": "npm run clean --workspaces",
    "clean:all": "npm run clean --workspaces && rimraf .cache",
    "build": "lerna run build --stream --sort",
    "rebuild": "npm run clean:all && npm run build",
    "release:validate": "node scripts/check-release.mjs",
    "release:publish:dry-run": "node scripts/publish-packages.mjs --dry-run",
    "release:check": "npm run lint && npm run build && npm test && npm run release:validate",
    "ci": "npm run release:check"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vitest": "^0.5.4",
    "lerna": "^9.0.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
