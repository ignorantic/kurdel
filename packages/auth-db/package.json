{
  "name": "@kurdel/auth-db",
  "version": "1.0.0",
  "description": "Database adapters for @kurdel/auth",
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": ["lib"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf lib ../../.cache/tsconfig.auth-db.build.tsbuildinfo",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:force": "npm run clean && tsc -p tsconfig.build.json --force && tsc-alias -p tsconfig.build.json"
  },
  "keywords": ["auth", "database", "framework"],
  "author": "Andrii Sorokin",
  "license": "MIT",
  "dependencies": {
    "@kurdel/auth": "^1.0.0",
    "@kurdel/common": "^1.0.0",
    "@kurdel/core": "^1.0.0",
    "@kurdel/db": "^1.0.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16"
  }
}
