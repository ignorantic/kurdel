{
  "name": "@kurdel/db",
  "version": "0.1.0-beta.3",
  "description": "Database abstractions with SQLite and PostgreSQL adapters for Kurdel",
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "prepack": "npm run build",
    "test": "vitest run",
    "clean": "rimraf lib ../../.cache/tsconfig.db.build.tsbuildinfo",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:force": "npm run clean && tsc -p tsconfig.build.json --force && tsc-alias -p tsconfig.build.json"
  },
  "keywords": [
    "kurdel",
    "database",
    "sqlite",
    "postgresql",
    "framework"
  ],
  "author": "Andrii Sorokin",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignorantic/kurdel.git",
    "directory": "packages/db"
  },
  "homepage": "https://github.com/ignorantic/kurdel/tree/main/packages/db#readme",
  "bugs": {
    "url": "https://github.com/ignorantic/kurdel/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/pg": "^8.21.0",
    "rimraf": "^3.0.2",
    "tsc-alias": "^1.8.16"
  },
  "peerDependencies": {
    "sqlite3": "^6.0.1"
  },
  "dependencies": {
    "@kurdel/common": "0.1.0-beta.3",
    "pg": "^8.23.0"
  }
}
